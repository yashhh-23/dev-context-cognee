{
  "name": "dev-context-cognee",
  "displayName": "Dev-Context Assistant",
  "description": "Cognee-powered developer context assistant with persistent memory across sessions. API keys are stored securely via VS Code SecretStorage.",
  "version": "0.1.1",
  "publisher": "SHUBHAMSUNILPAWAR",
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "icon": "icon.png",
  "keywords": [
    "cognee",
    "memory",
    "context",
    "bugs",
    "developer-tools"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "devContextSidebar",
          "name": "Dev-Context Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "devContext.rememberContext",
        "title": "Save Current Context to Cognee",
        "category": "Dev-Context",
        "icon": "$(save)"
      },
      {
        "command": "devContext.recallSimilarBugs",
        "title": "Recall Similar Bugs from Memory",
        "category": "Dev-Context",
        "icon": "$(search)"
      },
      {
        "command": "devContext.draftGitHubIssue",
        "title": "Draft GitHub Issue from Bug",
        "category": "Dev-Context",
        "icon": "$(issues)"
      },
      {
        "command": "devContext.setApiKey",
        "title": "Set Cognee API Key (stored in SecretStorage)",
        "category": "Dev-Context",
        "icon": "$(key)"
      },
      {
        "command": "devContext.rememberChangedFiles",
        "title": "Save All Changed Files to Cognee",
        "category": "Dev-Context",
        "icon": "$(save-all)"
      },
      {
        "command": "devContext.improveContext",
        "title": "Dev-Context: Improve Context",
        "icon": "$(sync)"
      },
      {
        "command": "devContext.forgetContext",
        "title": "Dev-Context: Forget Context",
        "icon": "$(trash)"
      },
      {
        "command": "devContext.resetOnboarding",
        "title": "Dev-Context: Reset Onboarding"
      },
      {
        "command": "devContext.resetDemo",
        "title": "Dev-Context: Reset Demo"
      }
    ],
    "keybindings": [
      {
        "command": "devContext.rememberContext",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus"
      },
      {
        "command": "devContext.recallSimilarBugs",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus"
      },
      {
        "command": "devContext.draftGitHubIssue",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus"
      },
      {
        "command": "devContext.rememberChangedFiles",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "devContext.improveContext",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      },
      {
        "command": "devContext.forgetContext",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d"
      }
    ],
    "configuration": {
      "title": "Dev-Context Assistant",
      "properties": {
        "devContext.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of your Dev-Context backend (FastAPI). Use http://localhost:8000 for local dev, or your deployed Render/Railway URL for production."
        },
        "devContext.enableCogneeCloud": {
          "type": "boolean",
          "default": true,
          "description": "Use Cognee Cloud for persistent memory storage across sessions."
        },
        "devContext.similarityThreshold": {
          "type": "number",
          "default": 0.75,
          "minimum": 0.5,
          "maximum": 1,
          "description": "Minimum similarity score (0.5–1.0) for recalling similar bugs from Cognee memory."
        },
        "devContext.maxRecallResults": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of similar bugs to recall from Cognee memory per query."
        },
        "devContext.watcherEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Auto-update context summary when active file changes."
        },
        "devContext.autoSaveOnFileSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save context to Cognee on every file save"
        },
        "devContext.feedDiagnosticsToCognee": {
          "type": "boolean",
          "default": true,
          "description": "Automatically feed code/compilation errors to Cognee context"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^2.19.0",
    "mocha": "^11.7.6",
    "typescript": "^5.9.3"
  }
}
