{
  "name": "dev-context-cognee",
  "displayName": "Dev Context Cognee",
  "description": "Send logs and context directly to Cognee memory",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:cognee.sendToMemory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cognee.sendToMemory",
        "title": "Cognee: Send Selection to Memory"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.x",
    "typescript": "^5.1.3"
  }
}
